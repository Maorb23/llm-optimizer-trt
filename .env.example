# Copy to .env, fill in real values, then source it from the repository root.
# The optimizer does not load .env automatically.
NB_PROJECT_ID="your-nebius-project-id"
SA_ID="your-service-account-id"
PUBLIC_KEY_ID="your-authorized-public-key-id"
NEBIUS_PRIVATE_KEY_PATH="/absolute/path/to/private-key.pem"

# S3-compatible storage used by the controller and framework workers.
AWS_ACCESS_KEY_ID="your-s3-access-key"
AWS_SECRET_ACCESS_KEY="your-s3-secret-key"
AWS_ENDPOINT_URL_S3="https://storage.eu-north1.nebius.cloud"

# Optional for gated models.
HF_TOKEN=""

# Optional live Optuna tracking. Tracking is disabled unless WANDB_PROJECT is set.
WANDB_API_KEY=""
WANDB_PROJECT=""
WANDB_ENTITY=""
WANDB_RUN_NAME=""
WANDB_TAGS="llm-optimizer,nebius"
WANDB_MODE="online"

# Keep this path on persistent storage; run commands from the repository root.
LLM_OPTIMIZER_CONTROLLER_DB=".local/optimizer-controller.sqlite"

# Set only for a diagnostic run. A failed worker sleeps for one hour so you can SSH in.
# NEBIUS_DEBUG_SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519.pub"
